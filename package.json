{
  "name": "guiaflow",
  "private": true,
  "version": "0.3.0",
  "description": "Editor e player de tours com captura de tela",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "node scripts/dev-server.mjs",
    "pack:extension": "node scripts/pack-extension.mjs",
    "test": "node --test extension/lib/*.test.js scripts/*.test.js js/*.test.js js/tour-schema/*.test.js electron/cartesia.test.js",
    "desktop": "electron .",
    "dist:desktop": "electron-builder --dir",
    "build:locales": "node scripts/build-locale-pages.mjs"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "^6.2.5"
  },
  "build": {
    "appId": "app.guiaflow",
    "productName": "GuiaFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "editor.html",
      "view.html",
      "ajuda.html",
      "favicon.*",
      "apple-touch-icon.png",
      "og-share.png",
      "brand/**/*",
      "css/**/*",
      "js/**/*",
      "data/**/*",
      "demo/**/*",
      "vendor/**/*",
      "extension/content.js",
      "extension/lib/demo-payload.js",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "identity": null
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "win": {
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0"
  }
}
