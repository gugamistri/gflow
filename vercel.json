{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "guiaflow-seven.vercel.app"
        }
      ],
      "destination": "https://guiaflow.pro/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "guiaflow-seven.vercel.app"
        }
      ],
      "destination": "https://guiaflow.pro/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/a/:version/:path*", "destination": "/:path*" },
    { "source": "/auth/callback", "destination": "/auth/callback.html" },
    { "source": "/v/:id", "destination": "/api/v/:id" }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-shares",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/cron/expire-shares.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/a/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    }
  ]
}
